{
  "name": "espa-assistente",
  "main": "index.mjs",
  "compatibility_date": "2026-09-11",
  "ai": {"binding": "AI"},
  "vars": {
    "ALLOWED_ORIGINS": "https://raphaellaurindo01-stack.github.io",
    "AUTH_MODE": "disabled"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "espa-provisional",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID"
  }],
  "ratelimits": [{"name": "RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}],
  "observability": {"enabled": false}
}
